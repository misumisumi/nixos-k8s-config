    "mode": "symlink",
    "source": "/nix/store/rwsxr89dz1qijmv78v9jhhvqiavnrgva-etc-nsswitch.conf",
    "target": "nsswitch.conf",
    "text": "passwd:    files systemd\ngroup:     files [success=merge] systemd\nshadow:    files\nsudoers:   files\n\nhosts:     mymachines resolve [!UNAVAIL=return] files myhostname dns\nnetworks:  files\n\nethers:    files\nservices:  files\nprotocols: files\nrpc:       files\n",
    "uid": 0,
    "user": "+0"
  },
