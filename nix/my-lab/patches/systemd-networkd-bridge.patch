+
+                if (r < 0)
+                        goto close_container;
+
+                /* Close IFLA_BRIDGE_VLAN_TUNNEL_INFO container for this entry */
+                r = sd_netlink_message_close_container(m);
+                if (r < 0)
+                        return r;
+
+                continue;
+
+close_container:
+                sd_netlink_message_close_container(m);
+                return r;
+        }
+
+        if (add_str)
