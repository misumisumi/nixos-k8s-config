+                        r = add_tunnel_info(m, entry->vid_start, entry->vni_start, 0, &add_str);
+                } else {
+                        /* VLAN range */
+                        r = add_tunnel_info(m, entry->vid_start, entry->vni_start, BRIDGE_VLAN_INFO_RANGE_BEGIN, &add_str);
+                        if (r < 0)
